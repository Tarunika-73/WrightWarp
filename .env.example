# Copy this file to .env and adjust as needed. Never commit .env.

# --- MongoDB (used by docker-compose and by the backend) ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB_NAME=wrightwarp

# Unauthenticated by default for local development - see docker-compose.yml
# for why. Set both of these (and uncomment the matching lines in
# docker-compose.yml) to run MongoDB with auth enabled.
# MONGO_USER=wrightwarp
# MONGO_PASSWORD=wrightwarp

# Optional: overrides every MONGO_* value above if set
# (e.g. for MongoDB Atlas or any other full connection string).
# MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net

# --- Application ---
APP_NAME=wrightwarp-api
ENVIRONMENT=development
