# Copy this file to .env and adjust as needed. Never commit .env.
# On Vercel, set these in Project Settings -> Environment Variables instead.

# --- MongoDB ---
# Full connection string (MongoDB Atlas or any other). Overrides every MONGO_* value below.
# URL-encode special characters in the username/password (e.g. @ -> %40).
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGO_DB_NAME=wrightwarp

# Local MongoDB via docker-compose (used only when MONGO_URI is not set).
MONGO_HOST=localhost
MONGO_PORT=27017
# MONGO_USER=wrightwarp
# MONGO_PASSWORD=change-me

# --- Application ---
APP_NAME=wrightwarp-api
ENVIRONMENT=development
# Comma-separated browser origins allowed by CORS (the deployed dashboard is same-origin).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Scheduled jobs ---
# Shared secret for /api/v1/cron/* and /api/v1/admin/* (Vercel Cron sends it as a Bearer token).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# CRON_SECRET=

# --- Index ---
DEMO_MODE=true
INDEX_BASE_YEAR=2024
# BOOKING_WINDOWS=1,7,15,30,45
# WEIGHTS_VERSION=DEMO-2024.1
