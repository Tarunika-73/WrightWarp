{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci --no-audit --no-fund && npm run build",
  "functions": {
    "index.py": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/v1/cron/daily",
      "schedule": "30 0 * * *"
    }
  ]
}
